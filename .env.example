# 复制为 .env 并按需修改；.env 不要提交到 git
# cp .env.example .env

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 留空 = 不鉴权；生产环境务必设置，且前端需带 X-API-Key
API_KEY=

# ---- LLM ----
# LLM_PROVIDER: openai | vllm（本地 vLLM OpenAI 兼容服务）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 本地 vLLM（LLM_PROVIDER=vllm 时生效）
# 启动示例（conda vllm 环境）：
#   vllm serve <模型路径> --served-model-name Qwen3.5-9B-AWQ --port 8001 \
#     --gpu-memory-utilization 0.8 --max-model-len 8192 --enforce-eager
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen3.5-9B-AWQ
VLLM_API_KEY=EMPTY
VLLM_CONTEXT_WINDOW=65536
VLLM_MAX_TOKENS=1024
# Qwen3.5 是推理模型，RAG 合成时关掉思考更直接
VLLM_DISABLE_THINKING=True

# ---- Embedding ----
# 可选: openai 或 huggingface
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=text-embedding-3-small
# 本地模型（首次需联网下载，之后可设 HF_LOCAL_FILES_ONLY=True 离线）
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_DEVICE=cuda
HF_LOCAL_FILES_ONLY=True

# ---- 向量库 ----
VECTOR_STORE_PROVIDER=chroma
CHROMA_PATH=./chroma_db
# docstore / index_store 持久化目录（查看、删除、后续 BM25 需要）
STORAGE_DIR=./storage

# ---- 文档处理 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=50
UPLOAD_FOLDER=./uploads
DOCS_FOLDER=./docs
MAX_FILE_SIZE=10485760

# ---- 检索 ----
MIN_SIMILARITY_SCORE=0.4
DEFAULT_TOP_K=5
# RETRIEVAL_MODE: dense(Chroma HNSW) | exact(精确余弦,评测用) | hybrid(BM25+稠密 RRF)
RETRIEVAL_MODE=hybrid
BM25_TOP_K=20
RRF_K=60

# ---- 重排 ----
# RERANK_PROVIDER: none | bge | bge-onnx | jev
RERANK_PROVIDER=bge
# 重排设备（仅 PyTorch bge 版）；vLLM 占满 GPU 时用 cpu
RERANK_DEVICE=cpu
# ONNX int8 版（CPU/AVX2，比 PyTorch CPU 快）；provider=bge-onnx 时生效
RERANK_ONNX_MODEL=kftof/bge-reranker-v2-m3-onnx-int8-avx2
# 送入重排的最大候选数（hybrid 融合后可能到 40）
RERANK_MAX_CANDIDATES=20
# 级联（provider=cascade）：Jev 粗筛 -> bge 精排。注意：级联召回上限=Jev 保留 gold 的能力，
# 实测在本语料上精度低于纯 bge，仅在「上下文预算/k 很大」时考虑。
RERANK_CASCADE_GATE=jev
RERANK_CASCADE_FINE=bge
RERANK_CASCADE_GATE_TOP_K=6
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_FETCH_K=20
RERANK_TOP_N=5
# Jev 决策模型（需 transformers>=5；MiniCPM5-1B-AWQ-INT4）
JEV_MODEL=cyankiwi/MiniCPM5-1B-AWQ-INT4
JEV_LOCAL_PATH=
JEV_DEVICE=cuda
JEV_THRESHOLD=0.45
JEV_MAX_LENGTH=512
JEV_BATCH_SIZE=8

# ---- Grounding / 幻觉核验 ----
# GROUNDING_PROVIDER: llm（LLM-as-judge，可靠） | jev（实验；1B NLI 实测不可用）
GROUNDING_PROVIDER=llm
GROUNDING_THRESHOLD=0.5
GROUNDING_MAX_CLAIMS=20
GROUNDING_MAX_CONTEXT_CHARS=4000

# ---- 其他 ----
DEBUG=False
# 查询日志（jsonl），用于从真实使用中挖评测 query
QUERY_LOG=./logs/queries.jsonl
